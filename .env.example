# ============================================
# PYMAX - Plantilla de Variables de Entorno
# COPIA este archivo como ".env" y completa SOLO tus valores.
# NUNCA subas el archivo ".env" real a Git (ya está en .gitignore).
# ============================================

# ---------- Supabase ----------
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_KEY="TU_ANON_PUBLIC_KEY"          # anon key (pública, ok en frontend)
SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"      # SOLO backend. NO exponer en frontend

# ---------- Base de datos (Supabase PostgreSQL) ----------
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ---------- Seguridad ----------
SECRET_KEY="UNA_CLAVE_LARGA_Y_ALEATORIA"    # para sesiones Flask

# ---------- Integraciones IA ----------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ---------- WhatsApp Business (Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ---------- Email (recordatorios de deudas) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# ---------- Producción ----------
PORT=5000
FLASK_ENV=production
